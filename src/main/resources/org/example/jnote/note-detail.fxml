<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.jnote.controllers.NoteDetailController"
      styleClass="detail-pane" VBox.vgrow="ALWAYS"
      stylesheets="@styles.css">
    <padding><Insets top="40" right="40" bottom="24" left="40"/></padding>

    <TextField fx:id="titleField" styleClass="note-title" promptText="Note title..."/>
    <Label fx:id="dateLabel" styleClass="note-date">
        <VBox.margin><Insets bottom="16"/></VBox.margin>
    </Label>
    <Separator styleClass="separator">
        <VBox.margin><Insets bottom="16"/></VBox.margin>
    </Separator>
    <TextArea fx:id="contentArea" styleClass="note-content"
              VBox.vgrow="ALWAYS" promptText="Start writing..."/>
    <Separator styleClass="separator">
        <VBox.margin><Insets top="16" bottom="12"/></VBox.margin>
    </Separator>
    <HBox spacing="8">
        <Button onAction="#handleSave" styleClass="save-button" text="Save"/>
        <Button onAction="#handleDelete" styleClass="delete-button" text="Delete"/>
    </HBox>
</VBox>