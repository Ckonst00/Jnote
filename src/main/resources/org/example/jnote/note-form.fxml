<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>

<VBox fx:controller="org.example.jnote.controllers.NoteFormController"
      xmlns:fx="http://javafx.com/fxml"
      styleClass="form-root"
      stylesheets="@styles.css">

    <!-- TITLE BAR -->
    <fx:include source="title-bar.fxml"/>

    <!-- CONTENT -->
    <VBox spacing="16">

        <padding>
            <Insets top="28" right="28" bottom="28" left="28"/>
        </padding>

        <Label text="New Note" styleClass="form-title"/>
        <Separator styleClass="separator"/>

        <Label text="Title" styleClass="form-label"/>
        <TextField fx:id="titleField"
                   styleClass="form-field"
                   promptText="Note title..."/>

        <Label text="Content" styleClass="form-label"/>
        <TextArea fx:id="content"
                  styleClass="form-textarea"
                  promptText="Start writing..."
                  prefHeight="200"/>

        <HBox alignment="CENTER_RIGHT" spacing="8">

            <Button fx:id="submitButton"
                    text="Submit"
                    styleClass="save-button"
                    onAction="#handleSubmitButtonAction"/>
        </HBox>

    </VBox>

</VBox>